# ---------------------------------------------------------------------------
# IntelPulse configuration. Copy to .env — every key below is OPTIONAL.
# A provider with no key reports itself as "unconfigured" in /api/health and is
# skipped during triage; it never silently returns a clean verdict.
# ---------------------------------------------------------------------------

# --- free API keys ---------------------------------------------------------
# Since v2 each workspace keeps its own keys, sealed, in its settings (admin:
# PATCH /api/settings, and the Settings pane). Keys found here are moved into
# the first organization once, on the first start of v2, and ignored after
# that: set them here only to bring 1.x keys along.
# https://www.abuseipdb.com/account/api      (1,000 checks/day free)
ABUSEIPDB_API_KEY=
# https://otx.alienvault.com/api             (free, unlimited-ish)
OTX_API_KEY=
# https://viz.greynoise.io/signup            (community tier, 100 lookups/day)
GREYNOISE_API_KEY=
# https://auth.abuse.ch/                     (ThreatFox + URLhaus share one key)
ABUSECH_AUTH_KEY=

# --- storage ---------------------------------------------------------------
# Compose overrides these; they are the local-dev defaults.
DATABASE_URL=sqlite+aiosqlite:///./data/intelpulse.db
REDIS_URL=
POSTGRES_PASSWORD=intelpulse

# --- behaviour -------------------------------------------------------------
CACHE_TTL_SECONDS=86400
PROVIDER_TIMEOUT_SECONDS=8
MAX_IOCS_PER_REQUEST=100
# Browser origins allowed to call this API: the dashboards, nothing else. A
# write from any other origin is refused (403), and so is one marked cross-site
# by Fetch Metadata. '*' turns that guard off and logs a warning; don't.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8123,http://127.0.0.1:8123,https://vinitrami-soc.github.io

# Required. 32 random bytes in base64: it seals raw alert text, provider keys and
# ticket credentials, and the server will not start without it. `make keys` writes
# one here; keep a copy somewhere safe, because a backup cannot be read without it.
# ENCRYPTION_KEY_FILE=/run/secrets/intelpulse_key reads it from a file instead.
ENCRYPTION_KEY=

# Deprecated: the shared token of IntelPulse 1.x. While set, 'Authorization: Bearer
# <token>' still reaches the endpoints 1.x had, in the original organization. New
# scripts should use API tokens an admin makes (POST /api/tokens); this goes in v3.
API_TOKEN=
# Session cookies are Secure; browsers accept them over plain HTTP on localhost.
# Set false only to test on another plain-HTTP address.
# COOKIE_SECURE=true
LOG_LEVEL=INFO
# JSON logs with automatic credential masking; set false for human-readable dev logs.
JSON_LOGS=true

# --- request-path limits ---------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRIAGE=30        # enrichment spends third-party quota
RATE_LIMIT_WRITE=60
RATE_LIMIT_READ=240
MAX_REQUEST_BYTES=1048576   # JSON bodies (1 MiB)
MAX_INPUT_CHARS=200000      # one paste
# Enable ONLY behind a proxy you control — otherwise any client can forge
# X-Forwarded-For and mint a fresh rate-limit identity per request.
TRUST_FORWARDED_FOR=false

# --- scoring weights (see docs/SCORING.md) ---------------------------------
WEIGHT_ABUSEIPDB=1.0
WEIGHT_OTX=0.9
WEIGHT_THREATFOX=1.2
WEIGHT_URLHAUS=1.1
WEIGHT_LOCAL_BLOCKLIST=1.0
WEIGHT_GREYNOISE=0.6
WEIGHT_GEO_ASN=0.25
GREYNOISE_BENIGN_MULTIPLIER=0.45

# --- demo / offline mode ---------------------------------------------------
# Lets `python -m app.cli seed` data (RFC 5737 documentation IPs) be triaged.
# Leave false in anything resembling production.
ALLOW_DOCUMENTATION_RANGES=false
