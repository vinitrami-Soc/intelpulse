# The build context is the repository root; only backend/ and web/ go in.
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
.git/
.github/
.claude/
.env
docs/
node_modules/
backend/.venv/
backend/data/*.db
backend/data/*.mmdb
web/tests/
web/nginx.conf
docker-compose.yml
# deploy/: its .env holds the server's secrets, and the image needs none of it
deploy/
